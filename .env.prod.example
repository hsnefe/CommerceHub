# Copy to .env.prod and fill in real values before deploying.
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

# Image coordinates.
# CI only publishes the "latest" tag from a v* git tag, so it does not exist
# until a release has been tagged; before that, use "main" or a sha- tag.
# Pinning an explicit version (e.g. 2.1.0) is better for a demo you want to
# stay put.
GHCR_OWNER=hsnefe
COMMERCEHUB_VERSION=latest

# Shared JWT signing key, minimum 32 characters
JWT_SECRET=replace-with-a-32-char-minimum-random-secret

# Database passwords
AUTH_DB_PASSWORD=replace-me
PRODUCT_DB_PASSWORD=replace-me
INVENTORY_DB_PASSWORD=replace-me
ORDER_DB_PASSWORD=replace-me
ANALYTICS_DB_PASSWORD=replace-me

# RabbitMQ credentials
RABBITMQ_USER=commercehub
RABBITMQ_PASSWORD=replace-me

# Grafana admin login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me
